{
  "rewrites": [
    { "source": "/", "destination": "/api/seo?slug=bioweblink&path=/" },
    { "source": "/admin", "destination": "/" },
    { "source": "/bookingclient-administracion-bio", "destination": "/" },
    { "source": "/master-admin", "destination": "/" },
    { "source": "/create-business", "destination": "/" },
    { "source": "/invite/:token", "destination": "/" },
    { "source": "/:slug", "destination": "/api/seo?slug=:slug" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/bookingclient-administracion-bio(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/master-admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/create-business(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/invite/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}